{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2019",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "src/Resources/assets/src/**/*.ts",
    "src/Resources/assets/tests/**/*.ts",
    "vitest.config.ts",
    "vite.config.ts"
  ]
}
