# PHPStan configuration for Page Builder Kit Bundle

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
        # 2.0 (W1-1): host fixtures that implement the ports removed in 2.0 (or an unrelated missing interface) on
        # purpose: they cannot be loaded, which is what the removed-ports kernel test checks.
        - tests/Fixtures/RemovedPorts/ImplementsStorage/*
        - tests/Fixtures/RemovedPorts/ImplementsContext/*
        - tests/Fixtures/RemovedPorts/Unrelated/*
    treatPhpDocTypesAsCertain: false
    ignoreErrors: []
    scanFiles:
        - examples/acme-grapes-block-pack/src/AcmeMarketingBlockPack.php

services:
    -
        class: Nowo\PageBuilderKitBundle\Tests\PHPStan\DoctrineGeneratedIdPropertiesExtension
        tags:
            - phpstan.properties.readWriteExtension

includes:
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
  - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon
