<?xml version="1.0" encoding="UTF-8"?>
<!-- Since 1.16.0: XML mapping of the bundle entity (same tables, columns, indexes and constraints as its attributes). Used with nowo_page_builder_kit.doctrine.mapping_type: xml, or by a host that maps the bundle entities itself. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\PageBuilderKitBundle\Entity\BuilderDocument" table="pb_document">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="structure" type="json"/>
        <one-to-one field="page" target-entity="Nowo\PageBuilderKitBundle\Entity\BuilderPage" inversed-by="document">
            <join-column unique="true" nullable="false" on-delete="CASCADE"/>
        </one-to-one>
        <one-to-many field="locales" target-entity="Nowo\PageBuilderKitBundle\Entity\BuilderDocumentLocale" mapped-by="document" orphan-removal="true">
            <cascade>
                <cascade-persist/>
                <cascade-remove/>
            </cascade>
        </one-to-many>
    </entity>
</doctrine-mapping>
