<?xml version="1.0" encoding="UTF-8"?>
<!-- Since 1.16.0: XML mapping of the bundle entity (same tables, columns, indexes and constraints as its attributes). Used with nowo_page_builder_kit.doctrine.mapping_type: xml, or by a host that maps the bundle entities itself. -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="Nowo\PageBuilderKitBundle\Entity\BuilderPageTranslation" table="pb_page_translation">
        <unique-constraints>
            <unique-constraint name="pb_page_translation_page_locale" columns="page_id,locale"/>
        </unique-constraints>
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="locale" type="string" length="8"/>
        <field name="title" type="string" length="255"/>
        <field name="slug" type="string" length="255"/>
        <field name="metaTitle" type="string" length="255" nullable="true"/>
        <field name="metaDescription" type="text" nullable="true"/>
        <field name="ogTitle" type="string" length="255" nullable="true"/>
        <field name="ogDescription" type="text" nullable="true"/>
        <field name="ogImage" type="string" length="512" nullable="true"/>
        <field name="canonicalUrl" type="string" length="512" nullable="true"/>
        <field name="robots" type="string" length="64" nullable="true"/>
        <many-to-one field="page" target-entity="Nowo\PageBuilderKitBundle\Entity\BuilderPage" inversed-by="translations">
            <join-column nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
