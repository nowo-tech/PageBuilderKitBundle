{#
  Page SEO of one locale (REQ-UI-003): UiKit form scaffold. Variable: page (View\FormPage from
  PageBuilderKitPageFactory::seo(): header admin.seo.title / admin.seo.hint with Revisions and Edit, back link to the
  list; form = BuilderPageSeoType; submit admin.seo.save; cancel = list). Also: builder_page, page_key, locales,
  locale, form.
  Data block filled: nowo_ui_form_body (locale tabs, then the fields grouped in three fieldsets — page, search / meta,
  Open Graph — and the REQ-TWIG-003 child loop for the rest).
#}
{% extends '@NowoUiKit/page/form.html.twig' %}
{% trans_default_domain 'NowoPageBuilderKitBundle' %}

{% block nowo_ui_form_body %}
    {% set _b = page.bundle %}
    {% set _tabs = [] %}
    {% for loc in locales %}
        {% set _tabs = _tabs|merge([{label: loc|upper, href: path('admin_page_builder_seo', {pageKey: page_key, locale: loc}), current: loc == locale}]) %}
    {% endfor %}
    {{ include(nowo_ui_partial('tabs', _b), {items: _tabs, aria_label: 'admin.content.locales'|trans, bundle: _b, region: 'locales', level: 'secondary'}, false) }}
    {% for group, names in {
        'admin.seo.section_page': ['title', 'slug'],
        'admin.seo.section_meta': ['metaTitle', 'robots', 'metaDescription', 'canonicalUrl'],
        'admin.seo.section_social': ['ogTitle', 'ogImage', 'ogDescription'],
    } %}
        <fieldset class="{{ nowo_ui_class('section', _b) }} pbk-seo-group">
            <legend class="{{ nowo_ui_class('card_title', _b) }}">{{ group|trans }}</legend>
            {% for child in form %}
                {% if not child.rendered and child.vars.name in names %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
        </fieldset>
    {% endfor %}
    {{ parent() }}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/page-builder.css', 'nowo_page_builder_kit') }}">
{% endblock %}
