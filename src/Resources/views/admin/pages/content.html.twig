{#
  Content fields (REQ-UI-003): UiKit settings scaffold. Variable: page (View\SettingsPage from
  PageBuilderKitPageFactory::content(): header admin.content.title / admin.content.hint with Edit (layout capability)
  and a back link to the list; section `schema` (layout capability, form = the add-field form, submit
  admin.content.add_field) and section `values` (content capability, form = the values form of the active locale or
  null, submit admin.content.save_values)). Also: schema_table (View\Table from schemaTable(): key, type, label; row
  action Remove behind a confirm), schema, fieldValues, locales, active_locale, pageKey, builder_page,
  asset_upload_enabled / asset_library_enabled / asset_upload_url / asset_library_url / asset_upload_csrf, and the 1.x
  variables (schema_add_form, schema_remove_forms, values_form, can_edit_schema, can_edit_values, field_types,
  reference_pages).
  Data block filled: nowo_ui_settings_section (schema: field table + add form; values: locale tabs + values form with
  the media picker on image fields). nowo_ui_modals: the media library <dialog> (UiKit `dialog` partial).
  Scripts: page-builder-admin.js (upload + library picker; no inline script).
#}
{% extends '@NowoUiKit/page/settings.html.twig' %}
{% trans_default_domain 'NowoPageBuilderKitBundle' %}

{% block nowo_ui_settings_section %}
    {% set _b = page.bundle %}
    {% if section.id == 'schema' %}
        {% if schema_table.rows is empty %}
            <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'admin.content.schema_empty'|trans }}</p>
        {% else %}
            {% embed nowo_ui_partial('table', bundle) with {table: schema_table, bundle: _b, nowo_ui_page_type: nowo_ui_page_type} only %}
                {% block nowo_ui_table_row %}
                    {% set _cell = nowo_ui_class('table_cell', bundle) %}
                    <td class="{{ _cell }}" data-label="{{ 'admin.content.col_key'|trans({}, 'NowoPageBuilderKitBundle') }}" data-required="1">
                        <code class="{{ nowo_ui_class('code', bundle) }}">{{ row.key }}</code>
                        {% if row.required|default(false) %}<span class="{{ nowo_ui_class('badge_warning', bundle) }}">{{ 'admin.content.field_required'|trans({}, 'NowoPageBuilderKitBundle') }}</span>{% endif %}
                    </td>
                    <td class="{{ _cell }}" data-label="{{ 'admin.content.col_type'|trans({}, 'NowoPageBuilderKitBundle') }}">
                        <span class="{{ nowo_ui_class('badge_neutral', bundle) }}">{{ row.type }}</span>
                        {% if row.fields is defined and row.fields is not empty %}
                            <span class="{{ nowo_ui_class('muted', bundle) }}">[{% for sub in row.fields %}{{ sub.key }}:{{ sub.type }}{% if not loop.last %}, {% endif %}{% endfor %}]</span>
                        {% endif %}
                    </td>
                    <td class="{{ _cell }}" data-label="{{ 'admin.content.col_label'|trans({}, 'NowoPageBuilderKitBundle') }}" data-nowo-ui-priority="2">{{ row.display_label|default(row.label|default('')) }}</td>
                {% endblock %}
            {% endembed %}
        {% endif %}
        {% if section.form %}
            {{ include(nowo_ui_partial('section_form', _b), {form: section.form, submit_label: section.submitLabel, bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
        {% endif %}
    {% elseif section.id == 'values' %}
        {% set _tabs = [] %}
        {% for locale in locales %}
            {% set _tabs = _tabs|merge([{label: locale|upper, href: path('admin_page_builder_content', {pageKey: pageKey, locale: locale}), current: locale == active_locale}]) %}
        {% endfor %}
        {{ include(nowo_ui_partial('tabs', _b), {items: _tabs, aria_label: 'admin.content.locales'|trans, bundle: _b, region: 'locales', level: 'secondary'}, false) }}
        {% set values_form = section.form %}
        {% if values_form is null %}
            <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'admin.content.no_fields'|trans }}</p>
        {% else %}
            {{ form_start(values_form, {attr: {class: nowo_ui_class('form', _b), 'data-nowo-ui-region': 'form'}}) }}
                {% set labels_locale = values_form.fieldLabels[active_locale]|default(null) %}
                {% set values_locale = values_form.fieldValues[active_locale]|default(null) %}
                {% for field in schema %}
                    {% set current = fieldValues[active_locale][field.key]|default(field.default|default(field.type == 'bool' ? false : '')) %}
                    <fieldset class="{{ nowo_ui_class('section', _b) }} pbk-content-field" data-pbk-field-key="{{ field.key }}">
                        {% if labels_locale is not null and labels_locale[field.key] is defined %}
                            {{ form_row(labels_locale[field.key], {label: 'admin.content.field_label_locale'|trans({'%locale%': active_locale}), translation_domain: false}) }}
                        {% endif %}
                        {% if values_locale is not null and values_locale[field.key] is defined %}
                            {% if field.type == 'image' %}
                                {{ form_row(values_locale[field.key]) }}
                                {% if asset_library_enabled|default(false) or asset_upload_enabled|default(false) %}
                                    <div class="{{ nowo_ui_class('toolbar', _b) }} pbk-media-actions">
                                        {% if asset_library_enabled|default(false) %}
                                            <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}"
                                                    data-nowo-ui-dialog-open="pbk-media-library"
                                                    aria-haspopup="dialog" aria-controls="pbk-media-library"
                                                    data-pbk-media-pick
                                                    data-target="#field-{{ field.key }}"
                                                    data-library-url="{{ asset_library_url }}">{{ 'admin.content.browse_library'|trans }}</button>
                                        {% endif %}
                                        {% if asset_upload_enabled|default(false) %}
                                            <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}"
                                                    data-pbk-image-upload-btn
                                                    data-target="#field-{{ field.key }}"
                                                    data-upload-url="{{ asset_upload_url }}"
                                                    data-csrf="{{ asset_upload_csrf }}"
                                                    data-error-label="{{ 'admin.content.upload_failed'|trans }}">{{ 'admin.content.upload_image'|trans }}</button>
                                        {% endif %}
                                    </div>
                                {% endif %}
                                <img{% if current %} src="{{ current|pbk_safe_url(true)|e('html_attr') }}"{% else %} hidden{% endif %} alt="" class="pbk-image-preview" data-pbk-image-preview="#field-{{ field.key }}">
                            {% elseif field.type == 'repeater' %}
                                {{ form_row(values_locale[field.key]) }}
                                <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'admin.content.repeater_hint'|trans }}</p>
                            {% else %}
                                {{ form_row(values_locale[field.key]) }}
                            {% endif %}
                        {% endif %}
                    </fieldset>
                {% endfor %}
                {% if labels_locale is not null %}{% do labels_locale.setRendered %}{% endif %}
                {% if values_locale is not null %}{% do values_locale.setRendered %}{% endif %}
                {% if values_form.fieldLabels is defined %}{% do values_form.fieldLabels.setRendered %}{% endif %}
                {% if values_form.fieldValues is defined %}{% do values_form.fieldValues.setRendered %}{% endif %}
                {% for child in values_form %}
                    {% if not child.rendered %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
                <div class="{{ nowo_ui_class('form_actions', _b) }}">
                    <button type="submit" class="{{ nowo_ui_class('btn_primary', _b) }}">{{ section.submitLabel|nowo_ui_trans }}</button>
                </div>
            {{ form_end(values_form) }}
        {% endif %}
    {% endif %}
{% endblock %}

{% block nowo_ui_modals %}
    {{ parent() }}
    {% if asset_library_enabled|default(false) %}
        {% set _b = page.bundle %}
        {% set _body %}
            <p class="{{ nowo_ui_class('muted', _b) }}" data-pbk-media-empty hidden>{{ 'admin.content.media_library_empty'|trans }}</p>
            <p class="{{ nowo_ui_class('muted', _b) }}" data-pbk-media-error hidden>{{ 'admin.content.media_library_error'|trans }}</p>
            <div class="pbk-media-grid" data-pbk-media-grid></div>
        {% endset %}
        {{ include(nowo_ui_partial('dialog', _b), {id: 'pbk-media-library', title: 'admin.content.media_library'|trans, body: _body, size: 'lg', bundle: _b, attr: {'data-pbk-media-dialog': true, 'data-testid': 'pbk-media-library'}}, false) }}
    {% endif %}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/page-builder.css', 'nowo_page_builder_kit') }}">
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {% if asset_upload_enabled|default(false) or asset_library_enabled|default(false) %}
        {% set _csp_nonce = app.request is defined and app.request ? app.request.attributes.get('csp_nonce')|default('') : '' %}
        <script src="{{ asset('js/page-builder-admin.js', 'nowo_page_builder_kit') }}" defer{% if _csp_nonce %} nonce="{{ _csp_nonce }}"{% endif %}></script>
    {% endif %}
{% endblock %}
