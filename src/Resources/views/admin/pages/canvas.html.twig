{#
  GrapesJS canvas (REQ-UI-003 unique page, listed in docs/TEMPLATES.md): extends the layout directly
  (page.layout ?? nowo_ui_layout.admin) and fills the canonical blocks. Variable: page (View\ShowPage from
  PageBuilderKitPageFactory::canvas(): header admin.canvas.title with SEO, Revisions and Preview, back link to the
  list). The save / publish / unpublish buttons are script buttons (page-builder-canvas.js, no inline handlers).
  Also: builder_page, page_key, locales, default_locale, structure, grapesjs_config, csrf_token, document_*_url,
  page_status, preview_url. The GrapesJS editor scripts are loaded by page-builder-canvas.js from
  grapesjs_config.pluginCdnBase; its stylesheets are local assets — this template prints no CDN asset.
#}
{% extends page.layout ?? nowo_ui_layout.admin %}
{% trans_default_domain 'NowoPageBuilderKitBundle' %}
{% set nowo_ui_bundle = page.bundle %}

{% block nowo_ui_document_title %}{{ page.header.title|nowo_ui_trans }}{% endblock %}

{% block nowo_ui_page_header %}{{ nowo_ui_page_header(page.header, page.bundle) }}{% endblock %}

{% block nowo_ui_content %}
    {% set _b = page.bundle %}
    {% set _published = page_status == 'published' %}
    {% set _badge_published = nowo_ui_class('badge_success', _b) %}
    {% set _badge_draft = nowo_ui_class('badge_neutral', _b) %}
    <div id="page-builder-canvas"
         class="pbk-canvas pbk-canvas--grapesjs pbk-canvas--grapesjs-full"
         data-nowo-ui-page="canvas"{{ nowo_ui_html_attrs(page.attributes) }}
         data-pbk-engine="grapesjs"
         data-pbk-save-url="{{ document_save_url }}"
         data-pbk-publish-url="{{ document_publish_url }}"
         data-pbk-unpublish-url="{{ document_unpublish_url }}"
         data-pbk-page-status="{{ page_status }}"
         data-pbk-label-draft="{{ 'admin.status.draft'|trans|e('html_attr') }}"
         data-pbk-label-published="{{ 'admin.status.published'|trans|e('html_attr') }}"
         data-pbk-label-loading="{{ 'admin.canvas.loading'|trans }}"
         data-pbk-class-tab="{{ nowo_ui_class('tab', _b) }}"
         data-pbk-class-tab-active="{{ nowo_ui_class('tab_active', _b) }}"
         data-pbk-csrf="{{ csrf_token }}"
         data-pbk-default-locale="{{ default_locale }}"
         data-pbk-grapes-config="{{ grapesjs_config|json_encode|e('html_attr') }}"
         data-pbk-structure="{{ structure|json_encode|e('html_attr') }}">

        <div class="{{ nowo_ui_class('toolbar', _b) }} pbk-canvas__toolbar" data-nowo-ui-region="toolbar">
            <span class="{{ _published ? _badge_published : _badge_draft }}"
                  data-pbk-status-badge
                  data-pbk-status-value="{{ page_status }}"
                  data-pbk-class-published="{{ _badge_published }}"
                  data-pbk-class-draft="{{ _badge_draft }}">{{ _published ? 'admin.status.published'|trans : 'admin.status.draft'|trans }}</span>
            <button type="button" class="{{ nowo_ui_class('btn_primary', _b) }}" data-pbk-action="save">{{ 'admin.canvas.save'|trans }}</button>
            <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-pbk-action="publish"{% if _published %} hidden{% endif %}>{{ 'admin.canvas.publish'|trans }}</button>
            <button type="button" class="{{ nowo_ui_class('btn_secondary', _b) }}" data-pbk-action="unpublish"{% if not _published %} hidden{% endif %}>{{ 'admin.canvas.unpublish'|trans }}</button>
        </div>

        {% set _tabs = [] %}
        {% for locale in locales %}
            {% set _tabs = _tabs|merge([{label: locale|upper, href: '#gjs', current: locale == default_locale, attr: {'data-pbk-locale-tab': locale}}]) %}
        {% endfor %}
        {{ include(nowo_ui_partial('tabs', _b), {items: _tabs, aria_label: 'admin.canvas.locales'|trans, bundle: _b, region: 'tabs'}, false) }}

        <div id="gjs" class="pbk-gjs"></div>
        <p class="{{ nowo_ui_class('muted', _b) }} pbk-canvas__status" data-pbk-status role="status" aria-live="polite"></p>
    </div>
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {# GrapesJS editor + gradient picker styles: vendored copies (grapesjs 0.22.9, grapick 0.1.13), never a CDN. #}
    <link rel="stylesheet" href="{{ asset('css/grapes.min.css', 'nowo_page_builder_kit') }}">
    <link rel="stylesheet" href="{{ asset('css/grapick.min.css', 'nowo_page_builder_kit') }}">
    <link rel="stylesheet" href="{{ asset('css/page-builder.css', 'nowo_page_builder_kit') }}">
{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {% set _csp_nonce = app.request is defined and app.request ? app.request.attributes.get('csp_nonce')|default('') : '' %}
    <script type="module"{% if _csp_nonce %} nonce="{{ _csp_nonce }}"{% endif %} src="{{ asset('js/page-builder-canvas.js', 'nowo_page_builder_kit') }}"></script>
{% endblock %}
