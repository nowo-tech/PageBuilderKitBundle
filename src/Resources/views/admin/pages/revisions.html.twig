{#
  Revision history (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from
  PageBuilderKitPageFactory::revisions(): header admin.revisions.title / admin.revisions.hint with Edit, back link to
  the list; columns id (required), label, createdAt, engine (priority 2); rows = list<BuilderPageRevision>; row actions
  Diff and Restore (POST form behind a confirm); EmptyState admin.revisions.empty). Also: create_form (FormView: label
  of a manual snapshot), builder_page, page_key, revisions, engine, max_per_page, restore_forms.
  Data blocks filled: nowo_ui_list_filters ("Save version" form, then the default region), nowo_ui_list_row (cells).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoPageBuilderKitBundle' %}

{% block nowo_ui_list_filters %}
    {% set _b = page.bundle %}
    <section class="{{ nowo_ui_class('card', _b) }} pbk-revision-create"{{ nowo_ui_attrs('card', _b) }} data-testid="pbk-revision-create">
        <div class="{{ nowo_ui_class('card_body', _b) }}">
            {{ include(nowo_ui_partial('section_form', _b), {form: create_form, submit_label: 'admin.revisions.create'|trans, bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
        </div>
    </section>
    {{ parent() }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    <td class="{{ _cell }}" data-label="{{ 'admin.revisions.col_id'|trans }}" data-required="1"><code class="{{ nowo_ui_class('code', _b) }}">#{{ row.id }}</code></td>
    <td class="{{ _cell }}" data-label="{{ 'admin.revisions.col_label'|trans }}">
        {% if row.label %}{{ row.label }}{% else %}<span class="{{ nowo_ui_class('table_cell_muted', _b) }}">—</span>{% endif %}
    </td>
    <td class="{{ _cell }}" data-label="{{ 'admin.revisions.col_when'|trans }}"><time datetime="{{ row.createdAt|date('c') }}">{{ row.createdAt|date('Y-m-d H:i') }}</time></td>
    <td class="{{ _cell }}" data-label="{{ 'admin.revisions.col_engine'|trans }}" data-nowo-ui-priority="2"><span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ row.structure.engine|default('classic') }}</span></td>
{% endblock %}
