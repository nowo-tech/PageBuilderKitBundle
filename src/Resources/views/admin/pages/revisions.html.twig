{% extends nowo_page_builder_layout_template() %}
{% trans_default_domain 'NowoPageBuilderKitBundle' %}

{% block page_title %}{{ 'admin.revisions.title'|trans({'%key%': page_key}) }}{% endblock %}

{% block header_actions %}
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary btn-sm" href="{{ path('admin_page_builder_list') }}">{{ 'admin.pages.list'|trans }}</a>
        {% if engine == 'grapesjs' %}
            <a class="btn btn-primary btn-sm" href="{{ path('admin_page_builder_canvas', {pageKey: page_key}) }}">{{ 'admin.pages.edit'|trans }}</a>
        {% else %}
            <a class="btn btn-warning btn-sm" href="{{ path('admin_page_builder_sections', {pageKey: page_key}) }}">{{ 'admin.pages.sections'|trans }}</a>
        {% endif %}
    </div>
{% endblock %}

{% block admin %}
    <p class="text-muted">{{ 'admin.revisions.hint'|trans({'%max%': max_per_page}) }}</p>

    <form method="post" action="{{ create_url }}" class="mb-4 d-flex flex-wrap gap-2 align-items-end">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
        <div>
            <label class="form-label" for="pbk-revision-label">{{ 'admin.revisions.label'|trans }}</label>
            <input id="pbk-revision-label" class="form-control form-control-sm" type="text" name="label" maxlength="255" placeholder="{{ 'admin.revisions.label_placeholder'|trans }}">
        </div>
        <button type="submit" class="btn btn-success btn-sm">{{ 'admin.revisions.create'|trans }}</button>
    </form>

    {% if revisions is empty %}
        <p class="text-muted">{{ 'admin.revisions.empty'|trans }}</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>{{ 'admin.revisions.col_id'|trans }}</th>
                        <th>{{ 'admin.revisions.col_label'|trans }}</th>
                        <th>{{ 'admin.revisions.col_when'|trans }}</th>
                        <th>{{ 'admin.revisions.col_engine'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for revision in revisions %}
                        <tr>
                            <td>#{{ revision.id }}</td>
                            <td>{{ revision.label|default('—') }}</td>
                            <td><time datetime="{{ revision.createdAt|date('c') }}">{{ revision.createdAt|date('Y-m-d H:i') }}</time></td>
                            <td>
                                {% set _engine = revision.structure.engine|default('classic') %}
                                <span class="badge bg-secondary">{{ _engine }}</span>
                            </td>
                            <td class="text-end d-flex gap-2 justify-content-end">
                                <a class="btn btn-outline-secondary btn-sm"
                                   href="{{ path('admin_page_builder_revisions_diff', {pageKey: page_key, revisionId: revision.id}) }}">
                                    {{ 'admin.revisions.diff'|trans }}
                                </a>
                                <form method="post"
                                      action="{{ path('admin_page_builder_revisions_restore', {pageKey: page_key, revisionId: revision.id}) }}"
                                      onsubmit="return confirm({{ ('admin.revisions.restore_confirm')|trans|json_encode|raw }});">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token }}">
                                    <button type="submit" class="btn btn-outline-primary btn-sm">{{ 'admin.revisions.restore'|trans }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
{% endblock %}
