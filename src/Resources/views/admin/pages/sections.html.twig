{#
  Classic (schema v1) sections editor (REQ-UI-003): UiKit form scaffold. Variable: page (View\FormPage from
  PageBuilderKitPageFactory::sections(): header admin.sections.title / admin.sections.hint with SEO, Revisions, Preview
  and Publish or Unpublish (POST forms, publish capability), back link to the list; form = SectionsEditType; submit
  admin.sections.save; body-only mode without sections). Also: builder_page, page_key, locales, locale,
  sections_tree, form, publish_form, unpublish_form, is_classic.
  Data block filled: nowo_ui_form_body (legacy notice, locale tabs, one collapsible block per section with its
  columns and widgets — each widget sub-form through the REQ-TWIG-003 child loop —, else the empty state).
#}
{% extends '@NowoUiKit/page/form.html.twig' %}
{% trans_default_domain 'NowoPageBuilderKitBundle' %}

{% block nowo_ui_form_body %}
    {% set _b = page.bundle %}
    <div class="{{ nowo_ui_class('flash_warning', _b) }}" role="status" data-testid="pbk-legacy-notice">
        <strong>{{ 'admin.sections.legacy_badge'|trans }}</strong> — {{ 'admin.sections.legacy_banner'|trans }}
    </div>
    {% set _tabs = [] %}
    {% for loc in locales %}
        {% set _tabs = _tabs|merge([{label: loc|upper, href: path('admin_page_builder_sections', {pageKey: page_key, locale: loc}), current: loc == locale}]) %}
    {% endfor %}
    {{ include(nowo_ui_partial('tabs', _b), {items: _tabs, aria_label: 'admin.content.locales'|trans, bundle: _b, region: 'locales', level: 'secondary'}, false) }}
    {% for section in sections_tree %}
        <details class="{{ nowo_ui_class('card', _b) }} pbk-sections-block"{{ nowo_ui_attrs('card', _b) }} open>
            <summary class="{{ nowo_ui_class('card_header', _b) }}">
                <span class="{{ nowo_ui_class('card_title', _b) }}">{{ section.label }}</span>
                <code class="{{ nowo_ui_class('code', _b) }}">{{ section.id }}</code>
            </summary>
            <div class="{{ nowo_ui_class('card_body', _b) }}">
                {% for column in section.columns %}
                    <div class="pbk-sections-block__column">
                        <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'admin.sections.column'|trans({'%width%': column.width, '%id%': column.id}) }}</p>
                        {% for widget in column.widgets %}
                            <fieldset class="{{ nowo_ui_class('section', _b) }} pbk-sections-block__widget" data-pbk-depth="{{ widget.depth }}">
                                <legend>
                                    <strong>{{ widget.label|trans }}</strong>
                                    <span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ widget.type }} · {{ widget.id }}</span>
                                </legend>
                                {% if form is not null and form.widgets[widget.id] is defined %}
                                    {# REQ-TWIG-003: child loop over the widget's sub-form (SectionsEditType adds one field per widget prop) #}
                                    {% for child in form.widgets[widget.id] %}
                                        {% if not child.rendered %}
                                            {{ form_row(child) }}
                                        {% endif %}
                                    {% else %}
                                        <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'admin.sections.no_props'|trans }}</p>
                                    {% endfor %}
                                {% else %}
                                    <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'admin.sections.no_props'|trans }}</p>
                                {% endif %}
                            </fieldset>
                        {% else %}
                            <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'admin.sections.empty_column'|trans }}</p>
                        {% endfor %}
                    </div>
                {% endfor %}
            </div>
        </details>
    {% else %}
        {{ include(nowo_ui_partial('empty', _b), {message: 'admin.sections.empty'|trans, bundle: _b, region: 'empty', nowo_ui_page_type: nowo_ui_page_type}, false) }}
    {% endfor %}
    {% if page.formTag %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/page-builder.css', 'nowo_page_builder_kit') }}">
{% endblock %}
