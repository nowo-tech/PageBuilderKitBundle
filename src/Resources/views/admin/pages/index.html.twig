{% extends nowo_page_builder_layout_template() %}
{% trans_default_domain 'NowoPageBuilderKitBundle' %}

{% block page_title %}{{ 'admin.pages.title'|trans }}{% endblock %}

{% block admin %}
    <section class="pbk-pages mb-4">
        <h2 class="h4">{{ 'admin.pages.list'|trans }}</h2>
        {% if pages is empty %}
            <p class="text-muted">{{ 'admin.pages.empty'|trans }}</p>
        {% else %}
            <ul class="list-group">
                {% for page in pages %}
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2">
                        <span>
                            <strong>{{ page.pageKey }}</strong>
                            <span class="badge bg-secondary ms-2">{{ page.status.value }}</span>
                        </span>
                        <span class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_page_builder_seo', {pageKey: page.pageKey}) }}">
                            {{ 'admin.pages.seo'|trans }}
                        </a>
                        {% set _engine = page.document and page.document.structure.engine|default('classic') %}
                        {% if _engine == 'grapesjs' %}
                            <a class="btn btn-sm btn-primary" href="{{ path('admin_page_builder_canvas', {pageKey: page.pageKey}) }}">
                                {{ 'admin.pages.edit'|trans }}
                            </a>
                        {% else %}
                            <a class="btn btn-sm btn-warning" href="{{ path('admin_page_builder_sections', {pageKey: page.pageKey}) }}">
                                {{ 'admin.pages.sections'|trans }}
                            </a>
                        {% endif %}
                        </span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    <section class="pbk-create">
        <h2 class="h4">{{ 'admin.pages.create'|trans }}</h2>
        {{ form_start(create_form) }}
            {{ form_row(create_form.pageKey) }}
            {{ form_row(create_form.title) }}
            <button type="submit" class="btn btn-success">{{ 'admin.pages.create_submit'|trans }}</button>
        {{ form_end(create_form) }}
    </section>
{% endblock %}
