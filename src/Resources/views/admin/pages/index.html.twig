{% extends nowo_page_builder_layout_template() %}
{% trans_default_domain 'NowoPageBuilderKitBundle' %}

{% set _css_fw = nowo_page_builder_css_framework() %}
{% if _css_fw starts with 'bootstrap' or _css_fw == 'tabler' %}
    {% form_theme create_form 'bootstrap_5_layout.html.twig' %}
{% endif %}

{% block page_title %}{{ 'admin.pages.title'|trans }}{% endblock %}

{% block header_actions %}
    {% if nowo_page_builder_can('templates') %}
        <a class="btn btn-outline-secondary btn-sm" href="{{ path('admin_page_builder_templates') }}">{{ 'admin.templates.title'|trans }}</a>
    {% endif %}
{% endblock %}

{% block admin %}
    <section class="pbk-pages mb-4">
        <h2 class="h4">{{ 'admin.pages.list'|trans }}</h2>
        {% if pages is empty %}
            <p class="text-muted">{{ 'admin.pages.empty'|trans }}</p>
        {% else %}
            <ul class="list-group">
                {% for page in pages %}
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-2 flex-wrap">
                        <span>
                            <strong>{{ page.pageKey }}</strong>
                            <span class="badge bg-secondary ms-2">{{ page.status.value }}</span>
                            {% set _engine = page.document and page.document.structure.engine|default('classic') %}
                            {% if _engine == 'grapesjs' %}
                                <span class="badge text-bg-primary ms-1">Grapes</span>
                            {% else %}
                                <span class="badge text-bg-warning ms-1">{{ 'admin.pages.legacy'|trans }}</span>
                            {% endif %}
                        </span>
                        <span class="d-flex gap-2 flex-wrap">
                        {% if nowo_page_builder_can('content') or nowo_page_builder_can('layout') %}
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_page_builder_content', {pageKey: page.pageKey}) }}">
                                {{ 'admin.pages.content'|trans }}
                            </a>
                        {% endif %}
                        {% if nowo_page_builder_can('content') %}
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_page_builder_seo', {pageKey: page.pageKey}) }}">
                            {{ 'admin.pages.seo'|trans }}
                        </a>
                        {% endif %}
                        {% if nowo_page_builder_can('layout') or nowo_page_builder_can('content') or nowo_page_builder_can('templates') %}
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_page_builder_document_export', {pageKey: page.pageKey}) }}">
                            {{ 'admin.pages.export'|trans }}
                        </a>
                        {% endif %}
                        {% if nowo_page_builder_can('layout') %}
                        {{ form_start(duplicate_forms[page.pageKey], { attr: { class: 'd-inline' } }) }}
                            {% for child in duplicate_forms[page.pageKey] %}
                                {% if not child.rendered %}
                                    {{ form_widget(child) }}
                                {% endif %}
                            {% endfor %}
                            <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'admin.pages.duplicate'|trans }}</button>
                        {{ form_end(duplicate_forms[page.pageKey]) }}
                        {% endif %}
                        {% if nowo_page_builder_revisions_enabled() and nowo_page_builder_can('layout') %}
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_page_builder_revisions', {pageKey: page.pageKey}) }}">
                                {{ 'admin.pages.revisions'|trans }}
                            </a>
                        {% endif %}
                        {% if nowo_page_builder_can('layout') %}
                            {% if _engine == 'grapesjs' %}
                                <a class="btn btn-sm btn-primary" href="{{ path('admin_page_builder_canvas', {pageKey: page.pageKey}) }}">
                                    {{ 'admin.pages.edit'|trans }}
                                </a>
                            {% else %}
                                <a class="btn btn-sm btn-warning" href="{{ path('admin_page_builder_sections', {pageKey: page.pageKey}) }}">
                                    {{ 'admin.pages.sections'|trans }}
                                    <span class="badge text-bg-dark ms-1">{{ 'admin.pages.legacy'|trans }}</span>
                                </a>
                            {% endif %}
                        {% elseif nowo_page_builder_can('content') %}
                            <a class="btn btn-sm btn-primary" href="{{ path('admin_page_builder_content', {pageKey: page.pageKey}) }}">
                                {{ 'admin.pages.content'|trans }}
                            </a>
                        {% endif %}
                        </span>
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
    </section>

    {% if nowo_page_builder_can('layout') %}
    <section class="pbk-create card">
        <div class="card-header fw-semibold">{{ 'admin.pages.create'|trans }}</div>
        <div class="card-body">
            {{ form_start(create_form, { attr: { class: 'pbk-create-form row g-3' } }) }}
                {% for child in create_form %}
                    {% if not child.rendered %}
                        <div class="col-md-4">{{ form_row(child) }}</div>
                    {% endif %}
                {% endfor %}
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-success w-100">{{ 'admin.pages.create_submit'|trans }}</button>
                </div>
            {{ form_end(create_form) }}
        </div>
    </section>
    {% endif %}
{% endblock %}
