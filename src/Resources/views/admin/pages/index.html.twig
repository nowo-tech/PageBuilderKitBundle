{#
  Pages list (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from PageBuilderKitPageFactory::index():
  header admin.pages.title / admin.pages.intro with Templates (templates capability); columns pageKey (required),
  status, engine (priority 2); rows = list<BuilderPage>; row actions by capability: Edit (canvas, or the classic
  sections editor), Content, SEO, Export, Duplicate (POST form behind a dialog asking the new key) and Revisions;
  Pagination (50 per page); EmptyState admin.pages.empty). Also: engines (page key => grapesjs | classic),
  create_form (FormView, null without the layout capability), pages, current_page, total_pages, duplicate_forms.
  Data blocks filled: nowo_ui_list_row (cells), nowo_ui_list_after (the "Create page" card).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoPageBuilderKitBundle' %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    {% set _engine = engines[row.pageKey]|default('classic') %}
    <td class="{{ _cell }}" data-label="{{ 'admin.pages.col_key'|trans }}" data-required="1"><code class="{{ nowo_ui_class('code', _b) }}">{{ row.pageKey }}</code></td>
    <td class="{{ _cell }}" data-label="{{ 'admin.pages.col_status'|trans }}">
        <span class="{{ nowo_ui_class(row.status.value == 'published' ? 'badge_success' : 'badge_neutral', _b) }}">{{ ('admin.status.' ~ row.status.value)|trans }}</span>
    </td>
    <td class="{{ _cell }}" data-label="{{ 'admin.pages.col_engine'|trans }}" data-nowo-ui-priority="2">
        {% if _engine == 'grapesjs' %}
            <span class="{{ nowo_ui_class('badge_info', _b) }}">{{ 'admin.pages.engine_grapesjs'|trans }}</span>
        {% else %}
            <span class="{{ nowo_ui_class('badge_warning', _b) }}">{{ 'admin.pages.legacy'|trans }}</span>
        {% endif %}
    </td>
{% endblock %}

{% block nowo_ui_list_after %}
    {% if create_form|default(null) %}
        {% set _b = page.bundle %}
        <section class="{{ nowo_ui_class('card', _b) }} pbk-create"{{ nowo_ui_attrs('card', _b) }} data-testid="pbk-create-page">
            <header class="{{ nowo_ui_class('card_header', _b) }}">
                <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'admin.pages.create'|trans }}</h2>
            </header>
            <div class="{{ nowo_ui_class('card_body', _b) }}">
                {{ include(nowo_ui_partial('section_form', _b), {form: create_form, submit_label: 'admin.pages.create_submit'|trans, bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
            </div>
        </section>
    {% endif %}
{% endblock %}
