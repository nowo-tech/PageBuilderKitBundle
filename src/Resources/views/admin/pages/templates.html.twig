{% extends nowo_page_builder_layout_template() %}
{% trans_default_domain 'NowoPageBuilderKitBundle' %}

{% block page_title %}{{ 'admin.templates.title'|trans }}{% endblock %}

{% block header_actions %}
    <a class="btn btn-outline-secondary btn-sm" href="{{ path('admin_page_builder_templates_export_all') }}">{{ 'admin.templates.export_all'|trans }}</a>
    <a class="btn btn-outline-secondary btn-sm" href="{{ path('admin_page_builder_list') }}">{{ 'admin.pages.list'|trans }}</a>
{% endblock %}

{% block admin %}
    <p class="text-muted">{{ 'admin.templates.hint'|trans }}</p>

    <section class="mb-4">
        <h2 class="h5">{{ 'admin.templates.save_from_page'|trans }}</h2>
        {% if pages is empty %}
            <p class="text-muted">{{ 'admin.pages.empty'|trans }}</p>
        {% else %}
            {% for page in pages %}
                <div class="d-flex flex-wrap gap-2 align-items-end mb-2">
                    <span class="me-2"><code>{{ page.pageKey }}</code></span>
                    {{ form_start(save_forms[page.pageKey], { attr: { class: 'd-flex flex-wrap gap-2 align-items-end' } }) }}
                        {% for child in save_forms[page.pageKey] %}
                            {% if not child.rendered %}
                                {{ form_row(child) }}
                            {% endif %}
                        {% endfor %}
                        <button type="submit" class="btn btn-success btn-sm">{{ 'admin.templates.save'|trans }}</button>
                    {{ form_end(save_forms[page.pageKey]) }}
                </div>
            {% endfor %}
        {% endif %}
    </section>

    <section class="mb-4">
        <h2 class="h5">{{ 'admin.templates.import'|trans }}</h2>
        <p class="text-muted small">{{ 'admin.templates.import_hint'|trans }}</p>
        {{ form_start(import_form) }}
            {% for child in import_form %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
            <button type="submit" class="btn btn-primary btn-sm">{{ 'admin.templates.import_submit'|trans }}</button>
        {{ form_end(import_form) }}
    </section>

    {% if templates is empty %}
        <p class="text-muted">{{ 'admin.templates.empty'|trans }}</p>
    {% else %}
        <div class="table-responsive">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>{{ 'admin.templates.key'|trans }}</th>
                        <th>{{ 'admin.templates.label'|trans }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for template in templates %}
                        <tr>
                            <td><code>{{ template.templateKey }}</code></td>
                            <td>{{ template.label }}</td>
                            <td class="text-end">
                                <a class="btn btn-outline-secondary btn-sm mb-1" href="{{ path('admin_page_builder_templates_export', {templateKey: template.templateKey}) }}">{{ 'admin.templates.export'|trans }}</a>
                                {{ form_start(apply_forms[template.templateKey], { attr: { class: 'd-inline-flex flex-wrap gap-1 align-items-center mb-1' } }) }}
                                    {% for child in apply_forms[template.templateKey] %}
                                        {% if not child.rendered %}
                                            {{ form_row(child) }}
                                        {% endif %}
                                    {% endfor %}
                                    <button class="btn btn-primary btn-sm" type="submit">{{ 'admin.templates.apply'|trans }}</button>
                                {{ form_end(apply_forms[template.templateKey]) }}
                                {{ form_start(delete_forms[template.templateKey], {
                                    attr: {
                                        class: 'd-inline',
                                        'data-pbk-confirm': 'admin.templates.delete_confirm'|trans
                                    }
                                }) }}
                                    {% for child in delete_forms[template.templateKey] %}
                                        {% if not child.rendered %}
                                            {{ form_row(child) }}
                                        {% endif %}
                                    {% endfor %}
                                    <button class="btn btn-outline-danger btn-sm" type="submit">{{ 'admin.templates.delete'|trans }}</button>
                                {{ form_end(delete_forms[template.templateKey]) }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
    {# data-pbk-confirm forms: confirm() via listener (no inline onsubmit; strict CSP friendly). #}
    {% set _csp_nonce = app.request is defined and app.request ? app.request.attributes.get('csp_nonce')|default('') : '' %}
    <script src="{{ asset('js/page-builder-admin.js', 'nowo_page_builder_kit') }}" defer{% if _csp_nonce %} nonce="{{ _csp_nonce }}"{% endif %}></script>
{% endblock %}
