{#
  Templates (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from
  PageBuilderKitPageFactory::templates(): header admin.templates.title / admin.templates.hint with Export all, back
  link to the pages list; columns templateKey (required), label; rows = list<BuilderPageTemplate>; row actions Export,
  Create page (POST form with the target page fields, behind a dialog) and Delete (POST form behind a confirm);
  EmptyState admin.templates.empty). Also: pages, save_forms (page key => FormView), import_form, templates,
  apply_forms, delete_forms.
  Data blocks filled: nowo_ui_list_filters ("Save template from page" and "Import templates" cards, then the default
  region), nowo_ui_list_row (cells).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoPageBuilderKitBundle' %}

{% block nowo_ui_list_filters %}
    {% set _b = page.bundle %}
    <div class="{{ nowo_ui_class('cards', _b) }} pbk-template-tools">
        <section class="{{ nowo_ui_class('card', _b) }}"{{ nowo_ui_attrs('card', _b) }} data-testid="pbk-template-save">
            <header class="{{ nowo_ui_class('card_header', _b) }}"><h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'admin.templates.save_from_page'|trans }}</h2></header>
            <div class="{{ nowo_ui_class('card_body', _b) }}">
                {% for item in pages %}
                    <div class="pbk-template-save">
                        <code class="{{ nowo_ui_class('code', _b) }}">{{ item.pageKey }}</code>
                        {{ include(nowo_ui_partial('section_form', _b), {form: save_forms[item.pageKey], submit_label: 'admin.templates.save'|trans, bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
                    </div>
                {% else %}
                    <p class="{{ nowo_ui_class('muted', _b) }}">{{ 'admin.pages.empty'|trans }}</p>
                {% endfor %}
            </div>
        </section>
        <section class="{{ nowo_ui_class('card', _b) }}"{{ nowo_ui_attrs('card', _b) }} data-testid="pbk-template-import">
            <header class="{{ nowo_ui_class('card_header', _b) }}">
                <h2 class="{{ nowo_ui_class('card_title', _b) }}">{{ 'admin.templates.import'|trans }}</h2>
                <p class="{{ nowo_ui_class('card_intro', _b) }}">{{ 'admin.templates.import_hint'|trans }}</p>
            </header>
            <div class="{{ nowo_ui_class('card_body', _b) }}">
                {{ include(nowo_ui_partial('section_form', _b), {form: import_form, submit_label: 'admin.templates.import_submit'|trans, bundle: _b, nowo_ui_page_type: nowo_ui_page_type}, false) }}
            </div>
        </section>
    </div>
    {{ parent() }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    <td class="{{ _cell }}" data-label="{{ 'admin.templates.key'|trans }}" data-required="1"><code class="{{ nowo_ui_class('code', _b) }}">{{ row.templateKey }}</code></td>
    <td class="{{ _cell }}" data-label="{{ 'admin.templates.label'|trans }}">{{ row.label }}</td>
{% endblock %}
