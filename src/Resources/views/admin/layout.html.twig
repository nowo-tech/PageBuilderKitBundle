{#
  Deprecated since 1.12, removed in 2.0 (REQ-UI-003): the 1.x default admin layout. The bundle pages extend UiKit
  scaffolds and no longer use it; it is kept for page copies that still extend the deprecated
  `nowo_page_builder_layout_template()` function and fill `title`, `page_title`, `header_actions`, `admin`,
  `stylesheets` and `javascripts`. It extends the UiKit admin layout (`nowo_ui_kit.layouts.admin`) instead of shipping
  its own HTML shell, so it loads no CSS framework (the host layout does).
#}
{% extends nowo_ui_layout.admin %}
{% trans_default_domain 'NowoPageBuilderKitBundle' %}
{% set nowo_ui_bundle = 'NowoPageBuilderKitBundle' %}

{% block nowo_ui_document_title %}{% block title %}{{ 'admin.title'|trans }}{% endblock %}{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    {% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/page-builder.css', 'nowo_page_builder_kit') }}">
    {% endblock %}
{% endblock %}

{% block nowo_ui_page_header %}
    <header class="{{ nowo_ui_class('page_header', nowo_ui_bundle) }}">
        <h1 class="{{ nowo_ui_class('page_title', nowo_ui_bundle) }}">{% block page_title %}{{ 'admin.title'|trans }}{% endblock %}</h1>
        <div class="{{ nowo_ui_class('toolbar', nowo_ui_bundle) }}">{% block header_actions %}{% endblock %}</div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block admin %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {% block javascripts %}{% endblock %}
{% endblock %}
