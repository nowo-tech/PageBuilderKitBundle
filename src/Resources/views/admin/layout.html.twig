{# Default admin HTML shell. Hosts override via web_ui.layout_template. #}
{% trans_default_domain 'NowoPageBuilderKitBundle' %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_page_builder_css_framework() %}
<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}" class="nowo-ui-html nowo-ui--{{ _css_fw }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'admin.title'|trans }}{% endblock %}</title>
    {% block stylesheets %}
        {% if _css_fw starts with 'bootstrap' %}
            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
        {% endif %}
        <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
        <link rel="stylesheet" href="{{ asset('css/page-builder.css', 'nowo_page_builder_kit') }}">
    {% endblock %}
</head>
<body class="nowo-ui-body pbk-admin">
    <div class="nowo-ui-container container py-4">
        <header class="nowo-ui-header mb-4 d-flex justify-content-between align-items-center">
            <h1 class="nowo-ui-title mb-0">{% block page_title %}{{ 'admin.title'|trans }}{% endblock %}</h1>
            {% block header_actions %}{% endblock %}
        </header>
        <main class="nowo-ui-main">
            {% block nowo_ui_flashes %}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label == 'error' ? 'danger' : label }} nowo-ui-flash" role="alert">{{ message|trans({}, 'NowoPageBuilderKitBundle') }}</div>
                    {% endfor %}
                {% endfor %}
            {% endblock %}
            {% block admin %}{% endblock %}
        </main>
    </div>
    {% block javascripts %}
        {% if _css_fw starts with 'bootstrap' %}
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
        {% endif %}
    {% endblock %}
</body>
</html>
