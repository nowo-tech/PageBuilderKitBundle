{% set tag = settings.tag|default('div') %}
<{{ tag }} class="pbk-widget pbk-widget--container">
    {% if widget.children is defined and widget.children|length > 0 %}
        {% for child in widget.children %}
            {% include '@NowoPageBuilderKitBundle/widgets/_widget.html.twig' with { widget: child } %}
        {% endfor %}
    {% endif %}
</{{ tag }}>
