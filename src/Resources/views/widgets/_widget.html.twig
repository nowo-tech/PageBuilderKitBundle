{# Recursive public widget wrapper (supports nested children). #}
<div {{ nowo_pbk_element_attrs(widget.appearance|default({}), ['pbk-widget-wrap', 'pbk-widget-wrap--' ~ widget.type]) }}>
    {{ include(widget.template, {widget: widget, settings: widget.settings}) }}{# eats the newline, like the include tag did #}
</div>
