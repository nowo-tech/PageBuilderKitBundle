<section {{ nowo_pbk_element_attrs(section.appearance|default(section.settings|default({})), ['pbk-section']) }}>
    <div class="pbk-section__columns row">
        {% for column in section.columns %}
            {{ include('@NowoPageBuilderKitBundle/widgets/_column.html.twig', {column: column}) }}{# eats the newline, like the include tag did #}
        {% endfor %}
    </div>
</section>
