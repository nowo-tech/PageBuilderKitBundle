{% extends 'base.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block body %}
<section class="nowo-ui-card">
    <div class="nowo-ui-card__header"><h1 class="nowo-ui-card__title">Admin login</h1></div>
    <div class="nowo-ui-card__body">
        <p class="nowo-ui-muted">Use the in-memory demo account to access PageBuilderKit admin screens.</p>

        {% if error %}
            <div class="nowo-ui-flash nowo-ui-flash--error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <div class="nowo-ui-flash nowo-ui-flash--info" role="note">
            Credentials: <code class="nowo-ui-code">admin</code> / <code class="nowo-ui-code">admin</code>
        </div>

        {{ form_start(login_form, { action: path('app_login'), attr: { class: 'pbk-demo-login' } }) }}
            {% for child in login_form %}
                {% if not child.rendered %}
                    {{ form_row(child) }}
                {% endif %}
            {% endfor %}
        {{ form_end(login_form) }}
    </div>
</section>
{% endblock %}
