{% extends 'base.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <h1 class="h3 mb-3">Admin login</h1>
                <p class="text-muted">Use the in-memory demo account to access PageBuilderKit admin screens.</p>

                {% if error %}
                    <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                {% endif %}

                <div class="alert alert-secondary">
                    Credentials: <code>admin</code> / <code>admin</code>
                </div>

                <form method="post" action="{{ path('app_login') }}">
                    <div class="mb-3">
                        <label class="form-label" for="username">Username</label>
                        <input id="username" name="_username" type="text" class="form-control" value="{{ last_username }}" autocomplete="username" required autofocus>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="password">Password</label>
                        <input id="password" name="_password" type="password" class="form-control" autocomplete="current-password" required>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button class="btn btn-primary w-100" type="submit">Sign in</button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}
