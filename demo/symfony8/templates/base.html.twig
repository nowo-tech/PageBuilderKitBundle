{#
  REQ-DEMO-014: the demo shell is UiKit's admin layout with its default theme (no CSS framework, no CDN). Demo pages
  use the blocks `title`, `stylesheets`, `toolbar`, `body` and `javascripts`, mapped to the UiKit regions below.
#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Page Builder Kit Demo{% endblock %} — Symfony 8{% endblock %}

{% block nowo_ui_head %}
    {{ parent() }}
    {% if page_tree is defined and page_tree.seo is defined %}
        {% include '@NowoPageBuilderKitBundle/public/_seo_meta.html.twig' with { seo: page_tree.seo } %}
    {% endif %}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/page-builder.css', 'nowo_page_builder_kit') }}">
    {{ vite_entry_link_tags('app') }}
    {% block stylesheets %}{% endblock %}
{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    {% set _params = app.request.attributes.get('_route_params')|default({}) %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('showcase') }}">Page Builder Kit · Symfony 8</a>
        <nav class="nowo-ui-menu" aria-label="Page Builder Kit">
            {% for route, label in {showcase: 'Use cases', home: 'Home', compounds: 'Compounds', classic: 'Classic v1', draft: 'Draft', i18n: 'i18n', multi_render: 'Multi-render', admin_page_builder_list: 'Admin'} %}
                <a class="nowo-ui-link" href="{{ path(route) }}"{% if _route == route %} aria-current="page"{% endif %} data-testid="demo-nav-{{ route }}">{{ label }}</a>
            {% endfor %}
        </nav>
        <div class="nowo-ui-header__end">
            {% if app.user %}
                <a class="nowo-ui-link" href="{{ path('app_logout') }}">Logout</a>
            {% else %}
                <a class="nowo-ui-link" href="{{ path('app_login') }}">Login</a>
            {% endif %}
            {% if _route %}
                <a class="nowo-ui-link" href="{{ path(_route, _params|merge(app.request.query.all)|merge({'_locale': app.request.locale == 'es' ? 'en' : 'es'})) }}">{{ app.request.locale == 'es' ? 'EN' : 'ES' }}</a>
            {% endif %}
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_flashes %}
    {% for type, css in {success: 'success', error: 'error', warning: 'warning', info: 'info'} %}
        {% for message in app.flashes(type) %}
            <div class="nowo-ui-flash nowo-ui-flash--{{ css }}" role="{{ type == 'error' ? 'alert' : 'status' }}">{{ message }}</div>
        {% endfor %}
    {% endfor %}
{% endblock %}

{% block nowo_ui_content %}{% block toolbar %}{% endblock %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('app') }}
    {% block javascripts %}{% endblock %}
{% endblock %}
