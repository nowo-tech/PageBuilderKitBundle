{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell. This file only declares the demo. Demo pages
    use the blocks `title`, `stylesheets`, `toolbar`, `body` and `javascripts`, mapped to the UiKit regions below. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Page Builder Kit',
    home_route: 'showcase',
    repository: 'https://github.com/nowo-tech/PageBuilderKitBundle',
    translation_domain: false,
    locales: ['en', 'es'],
    auth: {login_route: 'app_login', logout_route: 'app_logout'},
    nav: [
        {label: 'Use cases', route: 'showcase', section: 'Demo pages', testid: 'demo-nav-showcase'},
        {label: 'Home', route: 'home', section: 'Demo pages', testid: 'demo-nav-home'},
        {label: 'Compounds', route: 'compounds', section: 'Demo pages', testid: 'demo-nav-compounds'},
        {label: 'Classic v1', route: 'classic', section: 'Demo pages', testid: 'demo-nav-classic'},
        {label: 'Draft', route: 'draft', section: 'Demo pages', testid: 'demo-nav-draft'},
        {label: 'i18n', route: 'i18n', section: 'Demo pages', testid: 'demo-nav-i18n'},
        {label: 'Multi-render', route: 'multi_render', section: 'Demo pages', testid: 'demo-nav-multi_render'},
        {label: 'Admin pages', route: 'admin_page_builder_list', active: ['admin_page_builder_*'], section: 'Admin (admin / admin)', testid: 'demo-nav-admin_page_builder_list'},
    ],
} %}
{% block nowo_ui_document_title %}{% block title %}Page Builder Kit Demo{% endblock %} — Symfony 8{% endblock %}

{% block nowo_ui_head %}
    {{ parent() }}
    {% if page_tree is defined and page_tree.seo is defined %}
        {% include '@NowoPageBuilderKitBundle/public/_seo_meta.html.twig' with { seo: page_tree.seo } %}
    {% endif %}
{% endblock %}

{% block nowo_ui_styles %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('bundles/nowopagebuilderkit/css/page-builder.css') }}">
    {% block stylesheets %}{% endblock %}
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('app') }}
    {% block javascripts %}{% endblock %}
{% endblock %}
