{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} · PBK Demo{% endblock %}

{% block stylesheets %}
    {% for tree in page_trees %}
        {% if tree.engine|default('classic') == 'grapesjs' and tree.css|default('') %}
            <style id="pbk-grapes-css-{{ tree.pageKey|default(loop.index) }}">{{ tree.css|pbk_harden_css }}</style>
        {% endif %}
    {% endfor %}
{% endblock %}

{% block toolbar %}
<div class="nowo-ui-toolbar">
    <span class="nowo-ui-badge nowo-ui-badge--primary">{{ page_key }}</span>
    <span class="nowo-ui-badge nowo-ui-badge--info">{{ page_trees|length }} renders</span>
    <strong>{{ page_title }}</strong>
    <span class="nowo-ui-muted">· seed v{{ seed_version }} · Web Profiler collector demo</span>
    <a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" href="{{ path('showcase') }}">All use cases</a>
    {% for key in embed_keys %}
        <a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" href="{{ path(key) }}">{{ key }}</a>
    {% endfor %}
</div>
{% endblock %}

{% block body %}
<div class="nowo-ui-flash nowo-ui-flash--info" role="note">
    {% if locale == 'es' %}
        Esta ruta llama a <code class="nowo-ui-code">PageRenderProvider::getRenderedTree()</code>
        {{ page_trees|length }} veces en la misma petición HTTP
        (<code class="nowo-ui-code">{{ embed_keys|join(', ') }}</code>).
        Abre el panel <strong>Page Builder</strong> del Web Profiler: el contador de renders debe ser ≥ {{ page_trees|length }}.
    {% else %}
        This route calls <code class="nowo-ui-code">PageRenderProvider::getRenderedTree()</code>
        {{ page_trees|length }} times in one HTTP request
        (<code class="nowo-ui-code">{{ embed_keys|join(', ') }}</code>).
        Open the Web Profiler <strong>Page Builder</strong> panel: render count should be ≥ {{ page_trees|length }}.
    {% endif %}
</div>

{% for tree in page_trees %}
    <section class="pbk-multi-render-chunk" data-pbk-embed="{{ tree.pageKey|default(loop.index) }}">
        <div class="nowo-ui-toolbar">
            <span class="nowo-ui-badge nowo-ui-badge--neutral">#{{ loop.index }}</span>
            <span class="nowo-ui-badge nowo-ui-badge--neutral">{{ tree.pageKey|default('?') }}</span>
            <span class="nowo-ui-badge nowo-ui-badge--{{ tree.engine|default('') == 'classic' ? 'warning' : 'primary' }}">{{ tree.engine|default('?') }}</span>
            <strong>{{ tree.title|default(tree.pageKey) }}</strong>
            <a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" href="{{ path('admin_page_builder_canvas', {pageKey: tree.pageKey}) }}">Canvas</a>
        </div>
        {% if tree.engine|default('classic') == 'grapesjs' %}
            {% if tree.html|default('') is empty %}
                <div class="nowo-ui-flash nowo-ui-flash--warning" role="note">No content for <strong>{{ tree.pageKey }}</strong>.</div>
            {% else %}
                <div class="pbk-grapes-content">
                    {{ tree.html|pbk_harden_html }}
                </div>
            {% endif %}
        {% elseif tree.sections is empty %}
            <div class="nowo-ui-flash nowo-ui-flash--warning" role="note">No classic sections for <strong>{{ tree.pageKey }}</strong>.</div>
        {% else %}
            <div class="pbk-classic-demo">
                {% for section in tree.sections %}
                    {% include '@NowoPageBuilderKitBundle/widgets/_section.html.twig' with { section: section } %}
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endfor %}
{% endblock %}
