{% extends 'base.html.twig' %}

{% block title %}{{ page_title }} · PBK Demo{% endblock %}

{% block stylesheets %}
    {% for tree in page_trees %}
        {% if tree.engine|default('classic') == 'grapesjs' and tree.css|default('') %}
            <style id="pbk-grapes-css-{{ tree.pageKey|default(loop.index) }}">{{ tree.css|pbk_harden_css }}</style>
        {% endif %}
    {% endfor %}
{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}
        <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('showcase') }}">All use cases</a>
        {% for key in embed_keys %}
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path(key) }}">{{ key }}</a>
        {% endfor %}
    {% endset %}
    {{ include(nowo_ui_partial('page_header'), {
        title: page_title,
        intro: page_trees|length ~ ' renders · seed v' ~ seed_version ~ ' · Web Profiler collector demo',
        toolbar: _toolbar,
    }) }}
{% endblock %}

{% block nowo_ui_flashes %}
    {{ include('@NowoUiKit/demo_platform/_flashes.html.twig', {flash_messages: {info: [locale == 'es'
        ? 'Esta ruta llama a PageRenderProvider::getRenderedTree() ' ~ page_trees|length ~ ' veces en la misma petición HTTP (' ~ embed_keys|join(', ') ~ '). Abre el panel Page Builder del Web Profiler: el contador de renders debe ser ≥ ' ~ page_trees|length ~ '.'
        : 'This route calls PageRenderProvider::getRenderedTree() ' ~ page_trees|length ~ ' times in one HTTP request (' ~ embed_keys|join(', ') ~ '). Open the Web Profiler Page Builder panel: render count should be ≥ ' ~ page_trees|length ~ '.'
    ]}}) }}
{% endblock %}

{% block body %}
    {% for tree in page_trees %}
        {% set _is_grapes = tree.engine|default('classic') == 'grapesjs' %}
        {% set _is_empty = _is_grapes ? tree.html|default('') is empty : tree.sections is empty %}
        {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {
            title: '#' ~ loop.index ~ ' ' ~ tree.title|default(tree.pageKey),
            kind: 'content',
            empty: _is_empty,
            state_message: 'No content for ' ~ tree.pageKey|default('?') ~ '.',
            tree: tree,
            is_grapes: _is_grapes,
        } %}
            {% block section_actions %}
                <span class="nowo-ui-badge nowo-ui-badge--neutral">{{ tree.pageKey|default('?') }}</span>
                <span class="nowo-ui-badge nowo-ui-badge--{{ tree.engine|default('') == 'classic' ? 'warning' : 'primary' }}">{{ tree.engine|default('?') }}</span>
                <a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" href="{{ path('admin_page_builder_canvas', {pageKey: tree.pageKey}) }}">Canvas</a>
            {% endblock %}
            {% block section_body %}
                <div data-pbk-embed="{{ tree.pageKey|default(loop.index) }}" class="pbk-multi-render-chunk">
                    {% if is_grapes %}
                        <div class="pbk-grapes-content">
                            {{ tree.html|pbk_harden_html }}
                        </div>
                    {% else %}
                        <div class="pbk-classic-demo">
                            {% for section in tree.sections %}
                                {% include '@NowoPageBuilderKitBundle/widgets/_section.html.twig' with { section: section } %}
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            {% endblock %}
        {% endembed %}
    {% endfor %}
{% endblock %}
