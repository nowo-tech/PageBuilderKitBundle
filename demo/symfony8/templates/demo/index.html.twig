{% extends 'base.html.twig' %}

{% block title %}{{ page_tree.seo.title|default(page_title) }} · PBK Demo{% endblock %}

{% block stylesheets %}
    {% if page_tree.engine|default('classic') == 'grapesjs' and page_tree.css|default('') %}
        <style id="pbk-grapes-css">{{ page_tree.css|pbk_harden_css }}</style>
    {% endif %}
{% endblock %}

{% block toolbar %}
<div class="nowo-ui-toolbar">
    <span class="nowo-ui-badge nowo-ui-badge--primary">{{ page_key }}</span>
    {% if use_case is defined %}
        <span class="nowo-ui-badge nowo-ui-badge--{{ use_case.engine == 'classic' ? 'warning' : 'neutral' }}">{{ use_case.engine }}</span>
        {% if not use_case.publish %}<span class="nowo-ui-badge nowo-ui-badge--danger">draft</span>{% endif %}
    {% endif %}
    <strong>{{ page_title }}</strong>
    <span class="nowo-ui-muted">· seed v{{ seed_version|default('?') }} · {{ page_tree.engine|default('classic') }} · {{ page_tree.status|default('') }}</span>
    <a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" href="{{ path('showcase') }}">All use cases</a>
    {% if use_case is defined and use_case.engine == 'classic' %}
        <a class="nowo-ui-btn nowo-ui-btn--primary nowo-ui-btn--sm" href="{{ path('admin_page_builder_sections', {pageKey: page_key}) }}">Edit sections</a>
    {% else %}
        <a class="nowo-ui-btn nowo-ui-btn--primary nowo-ui-btn--sm" href="{{ path('admin_page_builder_canvas', {pageKey: page_key}) }}">Edit in GrapesJS</a>
    {% endif %}
    {% if use_case is not defined or use_case.publish %}
        <a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" href="{{ path('page_builder_public_render', {pageKey: page_key}) }}" target="_blank" rel="noopener">/p/{{ page_key }}</a>
    {% endif %}
    {% if page_tree.engine|default('') == 'classic' or (use_case is defined and use_case.engine == 'classic') %}
        <a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" href="{{ path(app.request.attributes.get('_route'), app.request.attributes.get('_route_params')|default({})|merge(app.request.query.all)|merge({'_locale': app.request.locale == 'es' ? 'en' : 'es'})) }}">
            Switch {{ app.request.locale == 'es' ? 'EN' : 'ES' }} content
        </a>
    {% endif %}
</div>
{% endblock %}

{% block body %}
{% include '@NowoPageBuilderKitBundle/public/_edit_button.html.twig' with { page_tree: page_tree } %}
{% if page_tree.engine|default('classic') == 'grapesjs' %}
    {% if page_tree.html|default('') is empty %}
        <div class="nowo-ui-flash nowo-ui-flash--info" role="note">
            No GrapesJS content for <strong>{{ page_key }}</strong>.
            Sign in (<code class="nowo-ui-code">admin</code>/<code class="nowo-ui-code">admin</code>) and open the canvas.
        </div>
    {% else %}
        <div class="pbk-grapes-content">
            {{ page_tree.html|pbk_harden_html }}
        </div>
    {% endif %}
{% elseif page_tree.sections is empty %}
    <div class="nowo-ui-flash nowo-ui-flash--info" role="note">No classic sections for <strong>{{ page_key }}</strong>.</div>
{% else %}
    <div class="pbk-classic-demo">
        {% for section in page_tree.sections %}
            {% include '@NowoPageBuilderKitBundle/widgets/_section.html.twig' with { section: section } %}
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
